# Encabezados que Cloudflare Pages agrega a las respuestas del sitio.
# Formato: https://developers.cloudflare.com/pages/configuration/headers/

# Ninguna página se puede mostrar dentro de un marco de otro sitio (clickjacking).
# El resto de la política de seguridad (CSP) va en cada página, desde astro.config.mjs.
/*
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000

# Archivos de Astro: el nombre cambia cuando cambia el contenido, así que se
# pueden guardar en el navegador un año.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# La dirección rossvtienda.pages.dev es solo técnica: que Google no la muestre.
https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex
