---
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import { comoPedir, tienda } from '../data/tienda';
import { enlaceWhatsApp, mensajePedido, ruta } from '../lib/enlaces';

const { pasos, entregas, preguntas } = comoPedir;
---

<Base
  titulo="Cómo pedir"
  descripcion={`Cómo hacer tu pedido en ${tienda.nombre}: elige tu ramo, personalízalo y envíanos tu pedido por WhatsApp.`}
  actual="como-pedir"
>
  <div class="contenedor pagina">
    <h1>Cómo pedir</h1>
    <p class="intro">Todos nuestros ramos se hacen a mano. Pedir es muy fácil:</p>

    <ol class="pasos">
      {
        pasos.map((paso) => (
          <li class="caja">
            <h2>{paso.titulo}</h2>
            <p>{paso.texto}</p>
          </li>
        ))
      }
    </ol>

    <div class="acciones">
      <a class="boton" href={ruta('/')}>Ver el catálogo</a>
      <a class="boton boton-secundario" href={enlaceWhatsApp(mensajePedido())} target="_blank" rel="noopener noreferrer">
        <Icono nombre="whatsapp" />
        Escríbenos
      </a>
    </div>

    {
      entregas.length > 0 && (
        <section aria-labelledby="entregas">
          <h2 id="entregas">Formas de entrega</h2>
          <ul class="entregas" role="list">
            {entregas.map((entrega) => (
              <li class="caja">
                <h3>{entrega.titulo}</h3>
                {entrega.puntos.length > 0 && (
                  <ul>
                    {entrega.puntos.map((punto) => (
                      <li>{punto}</li>
                    ))}
                  </ul>
                )}
                {entrega.datos.length > 0 && (
                  <>
                    <p class="datos-titulo">Datos que necesitamos</p>
                    <ul class="datos">
                      {entrega.datos.map((dato) => (
                        <li>{dato}</li>
                      ))}
                    </ul>
                  </>
                )}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <h2>Preguntas frecuentes</h2>
    <div class="preguntas">
      {
        preguntas.map(({ pregunta, respuesta }) => (
          <details class="caja">
            <summary>{pregunta}</summary>
            <p>{respuesta}</p>
          </details>
        ))
      }
    </div>

    <h2>¿Tienes otra duda?</h2>
    <p>
      Escríbenos por <a href={enlaceWhatsApp(mensajePedido())} target="_blank" rel="noopener noreferrer">WhatsApp</a> o mira
      todas las formas de <a href={ruta('/contacto/')}>contacto</a>.
    </p>
  </div>
</Base>

<style>
  .pasos {
    display: grid;
    gap: 12px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
    counter-reset: paso;
  }

  @media (min-width: 640px) {
    .pasos {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .pasos li {
    counter-increment: paso;
    position: relative;
    padding-left: 68px;
  }

  .pasos li::before {
    content: counter(paso);
    position: absolute;
    left: 18px;
    top: 18px;
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--tarjeta);
    font-family: var(--f-titulos);
    font-weight: 600;
    font-size: 1.2rem;
    font-variant-numeric: lining-nums;
  }

  .pasos h2 {
    margin: 0 0 4px;
    font-size: 1.2rem;
  }

  .acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
  }

  .entregas {
    display: grid;
    gap: 12px;
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 960px) {
    .entregas {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .entregas h3 {
    font-size: 1.3rem;
  }

  .entregas ul {
    display: grid;
    gap: 8px;
    margin: 12px 0 0;
    padding-left: 1.2em;
  }

  .datos-titulo {
    margin-top: 16px;
    font-weight: 700;
  }

  .entregas .datos {
    margin-top: 8px;
    padding-left: 0;
    list-style: none;
  }

  .datos li {
    position: relative;
    padding-left: 1.5em;
  }

  .datos li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--boton);
    font-weight: 700;
  }

  .preguntas {
    display: grid;
    gap: 10px;
    margin-top: 16px;
  }

  details {
    padding: 0;
  }

  summary {
    padding: 16px 20px;
    font-family: var(--f-titulos);
    font-weight: 600;
    font-size: 1.15rem;
    cursor: pointer;
  }

  details p {
    padding: 0 20px 18px;
  }
</style>
