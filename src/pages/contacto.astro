---
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import { conZona, tienda } from '../data/tienda';
import { enlaceWhatsApp, mensajePedido, ruta, usuarioDe } from '../lib/enlaces';

type Canal = {
  icono: 'whatsapp' | 'instagram' | 'tiktok' | 'facebook' | 'correo';
  titulo: string;
  detalle: string;
  href: string;
};

const canales: Canal[] = [
  {
    icono: 'whatsapp',
    titulo: 'WhatsApp',
    detalle: 'Pedidos, dudas y personalizados',
    href: enlaceWhatsApp(mensajePedido()),
  },
];
if (tienda.redes.instagram)
  canales.push({ icono: 'instagram', titulo: 'Instagram', detalle: usuarioDe(tienda.redes.instagram), href: tienda.redes.instagram });
if (tienda.redes.tiktok)
  canales.push({ icono: 'tiktok', titulo: 'TikTok', detalle: usuarioDe(tienda.redes.tiktok), href: tienda.redes.tiktok });
if (tienda.redes.facebook)
  canales.push({ icono: 'facebook', titulo: 'Facebook', detalle: usuarioDe(tienda.redes.facebook), href: tienda.redes.facebook });
if (tienda.correo)
  canales.push({ icono: 'correo', titulo: 'Correo', detalle: tienda.correo, href: `mailto:${tienda.correo}` });
---

<Base
  titulo="Contacto"
  descripcion={conZona(
    `Contacta a ${tienda.nombre} por WhatsApp, Instagram, TikTok o correo para pedidos y ramos personalizados.`,
  )}
  actual="contacto"
>
  <div class="contenedor pagina">
    <div class="pagina-cabeza">
      <p class="antetitulo">Contacto</p>
      <h1>Escríbenos</h1>
      <p class="intro">Para pedidos, dudas o ideas especiales. La forma más rápida de hacer tu pedido es por WhatsApp.</p>
    </div>

    <ul class="canales" role="list">
      {
        canales.map((c, i) => (
          <li>
            <a
              class:list={['canal', { principal: i === 0 }]}
              href={c.href}
              target={c.icono === 'correo' ? undefined : '_blank'}
              rel="noopener noreferrer"
            >
              <Icono nombre={c.icono} />
              <span>
                <strong>{c.titulo}</strong>
                <span class="detalle">{c.detalle}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <h2>Antes de escribir</h2>
    <p>
      En <a href={ruta('/como-pedir/')}>Cómo pedir</a> están los pasos y las preguntas frecuentes. Si buscas algo especial, mira
      los <a href={ruta('/pedidos-personalizados/')}>pedidos personalizados</a>.
    </p>
  </div>
</Base>

<style>
  .canales {
    display: grid;
    gap: 12px;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 640px) {
    .canales {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .canal {
    display: flex;
    align-items: center;
    gap: 16px;
    height: 100%;
    padding: 20px;
    border-radius: var(--radio);
    background: var(--crema);
    text-decoration: none;
    transition: background-color 0.15s ease;
  }

  .canal:hover {
    background: var(--tarjeta);
  }

  .canal :global(svg) {
    flex: none;
    width: 28px;
    height: 28px;
  }

  .canal > span {
    display: grid;
    min-width: 0;
  }

  .canal strong {
    font-family: var(--f-titulos);
    font-weight: 600;
    font-size: 1.25rem;
  }

  .detalle {
    color: var(--texto-suave);
    overflow-wrap: anywhere;
  }

  .principal {
    background: var(--boton);
    color: var(--crema);
  }

  .principal .detalle {
    color: var(--crema);
  }

  .principal:hover {
    background: var(--boton-hover);
  }
</style>
