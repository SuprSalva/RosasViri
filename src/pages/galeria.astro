---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icono from '../components/Icono.astro';
import { opiniones } from '../data/opiniones';
import { tienda } from '../data/tienda';
import { enlaceWhatsApp, usuarioDe } from '../lib/enlaces';
import { catalogo, urlProducto } from '../lib/catalogo';

// Fotos de ramos entregados: cualquier imagen dentro de src/content/galeria/.
// El nombre del archivo sirve de descripción; si empieza con fecha
// (2026-10-05-ramo-rojo.jpg) se ordenan de la más nueva a la más vieja.
const archivos = import.meta.glob<{ default: ImageMetadata }>(
  '../content/galeria/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}',
  { eager: true },
);
const entregados = Object.entries(archivos)
  .sort(([a], [b]) => b.localeCompare(a))
  .map(([ruta, modulo]) => {
    const nombre = ruta
      .split('/')
      .pop()!
      .replace(/\.[^.]+$/, '')
      .replace(/^\d{4}-\d{2}-\d{2}-?/, '')
      .replace(/[-_]+/g, ' ')
      .trim();
    return { src: modulo.default, alt: nombre ? nombre[0].toUpperCase() + nombre.slice(1) : 'Ramo entregado' };
  });

const delCatalogo = (await catalogo()).flatMap((s) =>
  s.productos.flatMap((p) => p.data.fotos.map((foto) => ({ foto, producto: p }))),
);

const invitacion = `Hola ${tienda.nombre} 🌷 Te comparto la foto de mi ramo.`;
---

<Base
  titulo="Galería"
  descripcion={`Fotos de ramos de listón satinado hechos a mano por ${tienda.nombre}: rosas eternas, girasoles y ramos con carritos Hot Wheels.`}
  actual="galeria"
>
  <div class="contenedor pagina">
    <div class="pagina-cabeza">
      <p class="antetitulo">Galería</p>
      <h1>Nuestros ramos</h1>
      <p class="intro">Algunos de los ramos que hemos hecho a mano, uno por uno.</p>
    </div>

    {
      entregados.length > 0 && (
        <section aria-labelledby="entregados">
          <h2 id="entregados">Ramos entregados</h2>
          <ul class="mosaico" role="list">
            {entregados.map(({ src, alt }) => (
              <li>
                <figure>
                  <Picture src={src} alt={alt} formats={['avif', 'webp']} widths={[320, 480, 720].filter((w) => w <= src.width)} sizes="(min-width: 900px) 340px, 50vw" />
                </figure>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section aria-labelledby="catalogo">
      <h2 id="catalogo">Del catálogo</h2>
      <ul class="mosaico" role="list">
        {
          delCatalogo.map(({ foto, producto }) => (
            <li>
              <a href={urlProducto(producto)}>
                <figure>
                  <Picture
                    src={foto.src}
                    alt={foto.alt}
                    formats={['avif', 'webp']}
                    widths={[320, foto.src.width].filter((w) => w <= foto.src.width)}
                    sizes="(min-width: 900px) 340px, 50vw"
                  />
                  <figcaption>{producto.data.nombre}</figcaption>
                </figure>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    {
      opiniones.length > 0 && (
        <section aria-labelledby="opiniones">
          <h2 id="opiniones">Lo que dicen nuestros clientes</h2>
          <ul class="opiniones" role="list">
            {opiniones.map((o) => (
              <li class="caja">
                <blockquote>
                  <p>“{o.texto}”</p>
                </blockquote>
                <p class="autor">
                  {o.nombre}
                  {o.producto && <span> · {o.producto}</span>}
                </p>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="comparte">
      <h2>¿Ya recibiste tu ramo?</h2>
      <p>
        Nos encantaría verlo.
        {
          tienda.redes.instagram && (
            <>
              Etiquétanos en Instagram <strong>{usuarioDe(tienda.redes.instagram)}</strong> o mándanos tu foto por
              WhatsApp.
            </>
          )
        }
      </p>
      <a class="boton" href={enlaceWhatsApp(invitacion)} target="_blank" rel="noopener">
        <Icono nombre="whatsapp" />
        Mandar mi foto
      </a>
    </section>
  </div>
</Base>

<style>
  .mosaico {
    columns: 2;
    column-gap: 12px;
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 640px) {
    .mosaico {
      columns: 3;
      column-gap: 16px;
    }
  }

  .mosaico li {
    break-inside: avoid;
    margin-bottom: 12px;
  }

  .mosaico a {
    display: block;
    text-decoration: none;
  }

  figure {
    margin: 0;
    border-radius: var(--radio);
    overflow: hidden;
    background: var(--crema);
  }

  figure :global(img) {
    width: 100%;
    height: auto;
    transition: transform 0.3s ease;
  }

  .mosaico a:hover :global(img) {
    transform: scale(1.03);
  }

  figcaption {
    padding: 8px 12px 10px;
    font-family: var(--f-titulos);
    font-weight: 600;
  }

  .opiniones {
    display: grid;
    gap: 12px;
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 640px) {
    .opiniones {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  blockquote {
    margin: 0;
    font-family: var(--f-titulos);
    font-style: italic;
    font-size: 1.15rem;
  }

  .autor {
    margin-top: 10px;
    font-weight: 700;
  }

  .autor span {
    font-weight: 400;
    color: var(--texto-suave);
  }

  .comparte {
    display: grid;
    gap: 12px;
    justify-items: start;
    margin-top: 48px;
    padding: 28px 24px;
    border-radius: 24px;
    background: var(--tarjeta);
  }

  .comparte h2 {
    margin: 0;
  }
</style>
