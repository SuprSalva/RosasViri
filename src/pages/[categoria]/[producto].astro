---
import { getCollection } from 'astro:content';
import { getImage, Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import GaleriaProducto from '../../components/GaleriaProducto.astro';
import Icono from '../../components/Icono.astro';
import TarjetaProducto from '../../components/TarjetaProducto.astro';
import { tienda } from '../../data/tienda';
import {
  categorias,
  galeriaDe,
  parrafos,
  productosDe,
  urlCategoria,
  urlProducto,
  type Producto,
} from '../../lib/catalogo';
import { enlaceWhatsApp, mensajePedido, precio, ruta } from '../../lib/enlaces';

export async function getStaticPaths() {
  const productos = await getCollection('productos');
  return productos.map((producto) => ({
    params: { categoria: producto.data.categoria, producto: producto.id },
    props: { producto },
  }));
}

interface Props {
  producto: Producto;
}
const { producto } = Astro.props;
const { nombre, resumen, opciones, disponible } = producto.data;
const entrada = (await categorias()).find((c) => c.id === producto.data.categoria);
if (!entrada) throw new Error(`El producto "${producto.id}" está en la sección "${producto.data.categoria}", que no existe.`);
const categoria = { id: entrada.id, ...entrada.data };
const relacionados = (await productosDe(categoria.id)).filter((p) => p.id !== producto.id).slice(0, 4);

const mensaje = mensajePedido(producto.data);
const descripcion = [resumen, producto.data.descripcion.trim()].filter(Boolean).join('. ');
const galeria = galeriaDe(producto);
const fotosGaleria = galeria.map(({ src, alt }) => ({ src, alt }));
// Cada color sabe en qué foto de la galería está, para mostrarla al elegirlo.
const colores = producto.data.colores.map((color) => {
  const indice = galeria.findIndex((foto) => foto.ruta === color.foto);
  return { ...color, indice, miniatura: galeria[indice].src };
});
const paraGoogle = await Promise.all(
  fotosGaleria.map(({ src }) => getImage({ src, format: 'jpg', width: Math.min(src.width, 1200) })),
);
const absoluta = (url: string) => new URL(url, Astro.site).href;

const datos = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: nombre,
    description: descripcion,
    image: paraGoogle.map((img) => absoluta(img.src)),
    brand: { '@type': 'Brand', name: tienda.nombre },
    offers: {
      '@type': 'Offer',
      price: producto.data.precio,
      priceCurrency: tienda.moneda,
      availability: disponible ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock',
      url: absoluta(urlProducto(producto)),
    },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { name: 'Inicio', item: absoluta(ruta('/')) },
      { name: 'Catálogo', item: absoluta(ruta('/catalogo/')) },
      { name: categoria.nombre, item: absoluta(urlCategoria(categoria.id)) },
      { name: nombre, item: absoluta(urlProducto(producto)) },
    ].map((paso, i) => ({ '@type': 'ListItem', position: i + 1, ...paso })),
  },
];
const textoBoton = disponible ? 'Pedir por WhatsApp' : 'Preguntar por WhatsApp';
---

<Base titulo={nombre} descripcion={descripcion} imagen={paraGoogle[0].src} datos={datos} actual="catalogo">
  <div class="contenedor">
    <a class="volver" href={urlCategoria(categoria.id)}>
      <Icono nombre="flecha" />
      {categoria.nombre}
    </a>

    <article class="producto">
      <GaleriaProducto fotos={fotosGaleria}>
        <button type="button" class="compartir" data-compartir>
          <Icono nombre="compartir" />
          <span class="visualmente-oculto">Compartir este producto</span>
        </button>
      </GaleriaProducto>

      <div class="info">
        <h1>{nombre}</h1>
        {resumen && <p class="resumen">{resumen}</p>}
        <p class="precio precio-num">{precio(producto.data.precio)}</p>
        {!disponible && <p class="aviso">Agotado por ahora. Escríbenos y te avisamos cuando vuelva.</p>}

        <div class="descripcion">
          {parrafos(producto.data.descripcion).map((parrafo) => <p>{parrafo}</p>)}
        </div>

        <form class="pedido" data-pedido data-mensaje={mensaje} data-numero={tienda.whatsapp}>
          {
            colores.length > 0 && (
              <fieldset>
                <legend>Elige el color</legend>
                <div class="muestras">
                  {colores.map((color) => (
                    <label class="muestra">
                      <input
                        class="visualmente-oculto"
                        type="radio"
                        name="Color"
                        value={color.nombre}
                        disabled={!color.disponible}
                        data-color
                        data-indice={color.indice}
                      />
                      <Image src={color.miniatura} alt="" width={128} height={128} loading="lazy" />
                      <span class="muestra-nombre">{color.nombre}</span>
                      {!color.disponible && <span class="muestra-agotado">Agotado</span>}
                    </label>
                  ))}
                </div>
              </fieldset>
            )
          }
          {
            opciones.length > 0 && (
              <fieldset>
                <legend>Personaliza tu pedido</legend>
                {opciones.map((opcion) => (
                  <label>
                    <span>{opcion.nombre}</span>
                    <input
                      type="text"
                      name={opcion.nombre}
                      placeholder={opcion.ejemplo && `Ej.: ${opcion.ejemplo}`}
                      autocomplete="off"
                      enterkeyhint="send"
                    />
                  </label>
                ))}
              </fieldset>
            )
          }
          <a
            class="boton pedir"
            data-pedir
            data-producto={nombre}
            data-precio={producto.data.precio}
            href={enlaceWhatsApp(mensaje)}
            target="_blank"
            rel="noopener noreferrer"
          >
            <Icono nombre="whatsapp" />
            {textoBoton}
          </a>
          <p class="nota">
            Te confirmamos disponibilidad, entrega y forma de pago por WhatsApp.{' '}
            <a href={ruta('/como-pedir/')}>¿Cómo pedir?</a>
          </p>
        </form>
      </div>
    </article>

    {
      relacionados.length > 0 && (
        <section class="seccion" aria-labelledby="relacionados">
          <h2 class="seccion-titulo" id="relacionados">
            También te puede gustar
          </h2>
          <ul class="rejilla" role="list">
            {relacionados.map((p) => (
              <li>
                <TarjetaProducto producto={p} />
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>

  <div class="barra" data-barra hidden>
    <div class="contenedor barra-fila">
      <p class="barra-precio precio-num"><span class="visualmente-oculto">{nombre}: </span>{precio(producto.data.precio)}</p>
      <a
        class="boton"
        data-pedir
        data-producto={nombre}
        data-precio={producto.data.precio}
        href={enlaceWhatsApp(mensaje)}
        target="_blank"
        rel="noopener noreferrer"
      >
        <Icono nombre="whatsapp" />
        {textoBoton}
      </a>
    </div>
  </div>
  <p class="visualmente-oculto" role="status" data-estado></p>
</Base>

<script>
  import { urlWhatsApp } from '../../lib/whatsapp';

  // Arma el mensaje de WhatsApp con el color elegido y lo que el cliente escribió.
  const formulario = document.querySelector<HTMLFormElement>('[data-pedido]');
  const botones = document.querySelectorAll<HTMLAnchorElement>('[data-pedir]');
  if (formulario) {
    const actualizar = () => {
      let mensaje = formulario.dataset.mensaje ?? '';
      for (const [nombre, valor] of new FormData(formulario)) {
        const texto = String(valor).trim();
        if (texto) mensaje += `\n${nombre}: ${texto}`;
      }
      const url = urlWhatsApp(formulario.dataset.numero ?? '', mensaje);
      const color = formulario.querySelector<HTMLInputElement>('[data-color]:checked')?.value;
      botones.forEach((boton) => {
        boton.href = url;
        // Para contar en Analytics qué colores se piden.
        if (color) boton.dataset.color = color;
      });
    };
    formulario.addEventListener('input', actualizar);
    formulario.addEventListener('change', (evento) => {
      actualizar();
      // Al elegir un color, la galería muestra su foto.
      const elegido = evento.target as HTMLInputElement;
      if (!elegido.matches('[data-color]')) return;
      document
        .querySelector('[data-galeria]')
        ?.dispatchEvent(new CustomEvent('ir-a-foto', { detail: Number(elegido.dataset.indice) }));
    });
    formulario.addEventListener('submit', (evento) => {
      evento.preventDefault();
      actualizar();
      botones[0]?.click();
    });
  }

  // Barra inferior con el botón de pedir, visible cuando el botón principal
  // no está en pantalla.
  const barra = document.querySelector<HTMLElement>('[data-barra]');
  const principal = formulario?.querySelector('[data-pedir]');
  if (barra && principal && 'IntersectionObserver' in window) {
    new IntersectionObserver(([entrada]) => {
      barra.hidden = entrada.isIntersecting;
    }).observe(principal);
  }

  // Compartir: menú nativo del celular o, si no hay, copiar el enlace.
  const compartir = document.querySelector<HTMLButtonElement>('[data-compartir]');
  const estado = document.querySelector<HTMLElement>('[data-estado]');
  compartir?.addEventListener('click', async () => {
    const datos = { title: document.title, url: location.href };
    if (navigator.share) {
      try {
        await navigator.share(datos);
      } catch {
        // La persona cerró el menú de compartir.
      }
      return;
    }
    try {
      await navigator.clipboard.writeText(datos.url);
      if (estado) estado.textContent = 'Enlace copiado';
      compartir.dataset.copiado = '';
      setTimeout(() => delete compartir.dataset.copiado, 2000);
    } catch {
      prompt('Copia este enlace:', datos.url);
    }
  });
</script>

<style>
  .volver {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-top: 16px;
    padding-block: 8px;
    font-weight: 700;
    color: var(--texto-suave);
    text-decoration: none;
  }

  .volver:hover {
    color: var(--texto);
  }

  .volver :global(svg) {
    width: 20px;
    height: 20px;
  }

  .producto {
    display: grid;
    gap: 24px;
    margin-top: 8px;
  }

  @media (min-width: 960px) {
    .producto {
      grid-template-columns: 500px 1fr;
      gap: 48px;
      align-items: start;
    }

    .producto :global(.galeria) {
      position: sticky;
      top: calc(var(--alto-encabezado) + 16px);
    }
  }

  .compartir {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    border: 1.5px solid var(--texto);
    border-radius: 50%;
    background: var(--fondo);
    color: var(--texto);
    cursor: pointer;
  }

  .compartir :global(svg) {
    width: 22px;
    height: 22px;
  }

  .compartir[data-copiado]::after {
    content: 'Enlace copiado';
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    padding: 4px 10px;
    border-radius: 8px;
    background: var(--texto);
    color: var(--crema);
    font-size: 0.85rem;
    white-space: nowrap;
  }

  .info h1 {
    font-size: clamp(2rem, 8vw, 2.8rem);
  }

  .resumen {
    margin-top: 6px;
    color: var(--texto-suave);
    font-size: 1.1rem;
  }

  .precio {
    margin-top: 14px;
    font-size: 2.2rem;
    font-weight: 600;
    line-height: 1;
  }

  .aviso {
    margin-top: 12px;
    padding: 10px 14px;
    border-radius: 12px;
    background: var(--crema);
  }

  .descripcion {
    margin-top: 16px;
  }

  .descripcion :global(p + p) {
    margin-top: 12px;
  }

  .pedido {
    margin-top: 24px;
    padding: 20px;
    border-radius: var(--radio);
    background: var(--tarjeta);
  }

  fieldset {
    border: 0;
    margin: 0 0 16px;
    padding: 0;
    display: grid;
    gap: 12px;
  }

  legend {
    padding: 0;
    margin-bottom: 12px;
    font-family: var(--f-titulos);
    font-weight: 600;
    font-size: 1.3rem;
  }

  label {
    display: grid;
    gap: 4px;
    font-weight: 700;
  }

  .muestras {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .muestra {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    width: 68px;
    font-weight: 400;
    text-align: center;
    cursor: pointer;
  }

  .muestra :global(img) {
    width: 60px;
    height: 60px;
    border: 3px solid transparent;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: 0 0 0 1px rgb(59 46 40 / 0.15);
    transition: border-color 0.15s ease;
  }

  .muestra:hover :global(img) {
    border-color: var(--crema);
  }

  .muestra:has(:checked) :global(img) {
    border-color: var(--boton);
  }

  .muestra:has(:checked) .muestra-nombre {
    font-weight: 700;
  }

  .muestra:has(:focus-visible) :global(img) {
    outline: 3px solid var(--texto);
    outline-offset: 2px;
  }

  .muestra:has(:disabled) {
    cursor: default;
  }

  .muestra:has(:disabled) :global(img) {
    opacity: 0.45;
  }

  .muestra-nombre {
    font-size: 0.92rem;
    line-height: 1.2;
  }

  .muestra-agotado {
    font-size: 0.8rem;
    color: var(--texto-suave);
  }

  input:not([type='radio']) {
    width: 100%;
    min-height: 48px;
    padding: 10px 14px;
    border: 1.5px solid var(--oliva);
    border-radius: 12px;
    background: var(--crema);
    color: var(--texto);
    font: inherit;
    font-weight: 400;
  }

  input::placeholder {
    color: #7a6a60;
  }

  .pedir {
    width: 100%;
  }

  .nota {
    margin-top: 12px;
    font-size: 0.95rem;
    color: var(--texto-suave);
  }

  .barra {
    position: fixed;
    inset: auto 0 0;
    z-index: 40;
    padding-block: 10px calc(10px + env(safe-area-inset-bottom));
    background: var(--crema);
    box-shadow: 0 -4px 16px rgb(59 46 40 / 0.14);
  }

  .barra[hidden] {
    display: none;
  }

  .barra-fila {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .barra-precio {
    font-size: 1.5rem;
    font-weight: 600;
  }

  .barra .boton {
    flex: 1;
    max-width: 320px;
    padding-inline: 16px;
  }
</style>
