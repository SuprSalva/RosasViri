---
import Base from '../../layouts/Base.astro';
import Icono from '../../components/Icono.astro';
import TarjetaProducto from '../../components/TarjetaProducto.astro';
import { categorias, productosDe, urlCategoria, type Categoria } from '../../lib/catalogo';
import { ruta } from '../../lib/enlaces';

export async function getStaticPaths() {
  const todas = await categorias();
  return todas.map((categoria) => ({ params: { categoria: categoria.id }, props: { categoria, todas } }));
}

interface Props {
  categoria: Categoria;
  todas: Categoria[];
}
const { categoria: entrada, todas } = Astro.props;
const categoria = { id: entrada.id, ...entrada.data };
const productos = await productosDe(categoria.id);
const otras = todas.filter((c) => c.id !== categoria.id).map((c) => ({ id: c.id, ...c.data }));
---

<Base titulo={categoria.nombre} descripcion={`${categoria.nombre}. ${categoria.descripcion}`} actual="catalogo">
  <div class="contenedor pagina">
    <a class="volver" href={ruta('/catalogo/')}>
      <Icono nombre="flecha" />
      Catálogo
    </a>
    <div class="pagina-cabeza">
      <h1>{categoria.nombre}</h1>
      <p class="intro">{categoria.descripcion}</p>
    </div>
    {
      productos.length > 0 ? (
        <ul class="rejilla" role="list">
          {productos.map((producto, i) => (
            <li>
              <TarjetaProducto producto={producto} nivel="h2" prioridad={i < 2} />
            </li>
          ))}
        </ul>
      ) : (
        <p class="vacio">Pronto tendremos productos en esta sección.</p>
      )
    }
    <nav class="otras" aria-label="Otras secciones">
      <p>También te puede gustar:</p>
      <div class="chips">
        {
          otras.map((c) => (
            <a class="chip" href={urlCategoria(c.id)}>
              {c.corto}
            </a>
          ))
        }
      </div>
    </nav>
  </div>
</Base>

<style>
  .volver {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-bottom: 12px;
    padding-block: 6px;
    font-weight: 700;
    color: var(--texto-suave);
    text-decoration: none;
  }

  .volver:hover {
    color: var(--texto);
  }

  .volver :global(svg) {
    width: 20px;
    height: 20px;
  }

  .vacio {
    margin-top: 24px;
  }

  .otras {
    margin-top: 40px;
    display: grid;
    gap: 10px;
  }

  .otras p {
    font-weight: 700;
  }
</style>
