---
import Base from '../layouts/Base.astro';
import Encabezado from '../components/Encabezado.astro';
import { ruta } from '../lib/enlaces';
---

<Base titulo="Página no encontrada">
  <Encabezado slot="encabezado" />
  <div class="contenedor pagina no-encontrada">
    <h1>Esta página no existe</h1>
    <p class="intro">Tal vez el enlace cambió o el producto ya no está. Mira todo el catálogo:</p>
    <a class="boton" href={ruta('/')}>Ir al catálogo</a>
  </div>
</Base>

<style>
  .no-encontrada {
    text-align: center;
  }

  .boton {
    margin-top: 24px;
  }
</style>
