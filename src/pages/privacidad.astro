---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { tienda } from '../data/tienda';

const pagina = await getEntry('paginas', 'privacidad');
if (!pagina) throw new Error('Falta src/content/paginas/privacidad.md');
const { Content } = await render(pagina);

const { responsable, correo, google } = tienda;
const pendiente = 'Por completar';
if (!responsable.nombre || !responsable.domicilio) {
  console.warn('[privacidad] Falta el nombre o el domicilio del responsable en src/data/tienda.json.');
}

const fecha = pagina.data.actualizado.toLocaleDateString('es-MX', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<Base
  titulo={pagina.data.titulo}
  descripcion={`Cómo ${tienda.nombre} trata tus datos personales y qué cookies usa este sitio.`}
>
  <article class="contenedor pagina legal">
    <div class="pagina-cabeza">
      <p class="antetitulo">Legal</p>
      <h1>{pagina.data.titulo}</h1>
      <p class="intro">Última actualización: {fecha}</p>
    </div>

    <section class="caja responsable" aria-labelledby="responsable">
      <h2 id="responsable">Responsable de tus datos</h2>
      <dl>
        <dt>Nombre</dt>
        <dd>{responsable.nombre || pendiente}</dd>
        <dt>Domicilio</dt>
        <dd>{responsable.domicilio || pendiente}</dd>
        {
          correo && (
            <>
              <dt>Correo de contacto</dt>
              <dd>
                <a href={`mailto:${correo}`}>{correo}</a>
              </dd>
            </>
          )
        }
      </dl>
      <p>
        {responsable.nombre ? `${responsable.nombre}, bajo la marca ${tienda.nombre},` : tienda.nombre} es responsable del
        tratamiento de los datos personales que nos compartes.
      </p>
    </section>

    <div class="texto">
      <Content />
    </div>

    <section id="cookies" aria-labelledby="titulo-cookies">
      <h2 id="titulo-cookies">Cookies y tecnologías de rastreo</h2>
      {
        google.analytics ? (
          <>
            <p>
              Usamos cookies de Google Analytics (<code>_ga</code> y <code>_ga_*</code>) para contar las visitas y saber
              qué páginas se ven más. La información se usa solo de forma estadística. Estas cookies{' '}
              <strong>solo se activan si las aceptas</strong> en el aviso de cookies.
            </p>
            <p>
              Si llegas desde un enlace de nuestras redes, tu navegador recuerda de cuál vino mientras dura la visita
              (no es una cookie y no sale de tu navegador), para incluirlo en esas estadísticas si aceptas las cookies.
            </p>
            <p>
              Guardamos tu decisión en tu navegador para no volver a preguntarte. Puedes cambiarla cuando quieras:{' '}
              <button type="button" class="enlace" data-preferencias-cookies>
                cambiar mis preferencias de cookies
              </button>
              .
            </p>
          </>
        ) : (
          <p>Este sitio no usa cookies ni tecnologías de rastreo.</p>
        )
      }
    </section>
  </article>
</Base>

<style>
  .legal {
    max-width: 800px;
  }

  .responsable {
    margin-top: 28px;
  }

  .responsable h2 {
    margin-top: 0;
    font-size: 1.3rem;
  }

  dl {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 6px 16px;
    margin: 14px 0;
  }

  dt {
    font-weight: 700;
  }

  dd {
    margin: 0;
    overflow-wrap: anywhere;
  }

  @media (max-width: 480px) {
    dl {
      grid-template-columns: 1fr;
      gap: 2px;
    }

    dd {
      margin-bottom: 8px;
    }
  }

  .texto :global(ul) {
    padding-left: 1.25em;
  }

  .texto :global(li + li) {
    margin-top: 4px;
  }

  .texto :global(p),
  .texto :global(ul) {
    margin: 12px 0 0;
  }

  .enlace {
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    font: inherit;
    text-decoration: underline;
    cursor: pointer;
  }
</style>
