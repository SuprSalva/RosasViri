---
// Solo se muestra si hay un ID de Google Analytics en tienda.json. Google
// Analytics no se carga (y no deja cookies) hasta que la persona acepta.
import { tienda } from '../data/tienda';
import { ruta } from '../lib/enlaces';

interface Props {
  idAnalytics: string;
}
const { idAnalytics } = Astro.props;
---

<section class="cookies" aria-label="Aviso de cookies" data-cookies data-ga={idAnalytics} data-moneda={tienda.moneda} hidden>
  <p>
    Usamos cookies de Google Analytics para saber cuántas personas visitan la tienda. Solo se activan si aceptas.{' '}
    <a href={ruta('/privacidad/#cookies')}>Más información</a>
  </p>
  <div class="botones">
    <button type="button" class="boton boton-secundario" data-rechazar>Rechazar</button>
    <button type="button" class="boton" data-aceptar>Aceptar</button>
  </div>
</section>

<script>
  type Ventana = Window & { dataLayer?: unknown[]; [clave: string]: unknown };

  const CLAVE = 'rossvtienda-cookies';
  const ventana = window as unknown as Ventana;
  const aviso = document.querySelector<HTMLElement>('[data-cookies]');
  const id = aviso?.dataset.ga ?? '';

  const leer = () => {
    try {
      return localStorage.getItem(CLAVE);
    } catch {
      return null;
    }
  };
  const guardar = (valor: 'si' | 'no') => {
    try {
      localStorage.setItem(CLAVE, valor);
    } catch {
      // Sin almacenamiento, la decisión dura solo esta visita.
    }
  };

  // gtag necesita recibir el objeto `arguments` tal cual.
  function gtag(..._args: unknown[]) {
    ventana.dataLayer = ventana.dataLayer ?? [];
    // eslint-disable-next-line prefer-rest-params
    ventana.dataLayer.push(arguments);
  }

  // Campaña de los enlaces con UTM (por ejemplo ?utm_source=instagram). Si la
  // persona llega por uno y acepta las cookies en otra página, la dirección ya
  // no los trae; se recuerdan durante la visita para no perder de qué red vino.
  const CAMPAÑA = 'rossvtienda-campaña';
  const UTM = ['source', 'medium', 'campaign', 'content', 'term'] as const;
  const utmEnDireccion = new URLSearchParams(location.search).has('utm_source');
  if (utmEnDireccion) {
    const parametros = new URLSearchParams(location.search);
    const campaña = Object.fromEntries(
      UTM.filter((clave) => parametros.get(`utm_${clave}`)).map((clave) => [
        `campaign_${clave === 'campaign' ? 'name' : clave}`,
        parametros.get(`utm_${clave}`),
      ]),
    );
    try {
      sessionStorage.setItem(CAMPAÑA, JSON.stringify(campaña));
    } catch {
      // Sin almacenamiento, solo se mide si acepta en la página de llegada.
    }
  }
  const campañaGuardada = (): Record<string, string> => {
    if (utmEnDireccion) return {}; // Analytics ya la lee de la dirección.
    try {
      return JSON.parse(sessionStorage.getItem(CAMPAÑA) ?? '{}');
    } catch {
      return {};
    }
  };

  let cargado = false;
  function cargarAnalytics() {
    if (cargado || !id) return;
    cargado = true;
    ventana[`ga-disable-${id}`] = false;
    gtag('js', new Date());
    gtag('config', id, campañaGuardada());
    // Desde aquí la cookie de Analytics ya recuerda de dónde vino la visita.
    try {
      sessionStorage.removeItem(CAMPAÑA);
    } catch {
      // Nada que borrar.
    }
    const script = document.createElement('script');
    script.async = true;
    script.src = `https://www.googletagmanager.com/gtag/js?id=${encodeURIComponent(id)}`;
    document.head.append(script);
  }

  function borrarCookies() {
    ventana[`ga-disable-${id}`] = true;
    const partes = location.hostname.split('.');
    const dominios = partes.slice(0, -1).map((_, i) => `.${partes.slice(i).join('.')}`);
    for (const cookie of document.cookie.split(';')) {
      const nombre = cookie.split('=')[0].trim();
      if (!/^_ga(_|$)|^_gid$/.test(nombre)) continue;
      document.cookie = `${nombre}=; Max-Age=0; path=/`;
      for (const dominio of dominios) document.cookie = `${nombre}=; Max-Age=0; path=/; domain=${dominio}`;
    }
  }

  if (aviso && id) {
    const decision = leer();
    if (decision === 'si') cargarAnalytics();
    else if (decision !== 'no') aviso.hidden = false;

    aviso.querySelector('[data-aceptar]')?.addEventListener('click', () => {
      guardar('si');
      aviso.hidden = true;
      cargarAnalytics();
    });
    aviso.querySelector('[data-rechazar]')?.addEventListener('click', () => {
      guardar('no');
      aviso.hidden = true;
      if (cargado) borrarCookies();
    });
    for (const boton of document.querySelectorAll('[data-preferencias-cookies]')) {
      boton.addEventListener('click', () => {
        aviso.hidden = false;
        aviso.querySelector<HTMLButtonElement>('[data-aceptar]')?.focus();
      });
    }

    // Cuenta cada pedido por WhatsApp (por producto y por página), solo si la
    // persona aceptó las cookies.
    const moneda = aviso.dataset.moneda ?? 'MXN';
    const contarPedido = (origen: HTMLElement) => {
      if (!cargado) return;
      const precio = Number(origen.dataset.precio);
      gtag('event', 'pedido_whatsapp', {
        producto: origen.dataset.producto ?? 'General',
        pagina: location.pathname,
        ...(origen.dataset.color && { color: origen.dataset.color }),
        ...(precio > 0 && { value: precio, currency: moneda }),
      });
    };
    document.addEventListener('click', (evento) => {
      const enlace = (evento.target as Element | null)?.closest<HTMLAnchorElement>('a[href^="https://wa.me/"]');
      if (enlace) contarPedido(enlace);
    });
    document.addEventListener('submit', (evento) => {
      const formulario = evento.target as HTMLFormElement;
      // El formulario de cada producto abre WhatsApp con un clic en su botón,
      // que ya se cuenta arriba.
      if (formulario.matches('form[data-producto]')) contarPedido(formulario);
    });
  }
</script>

<style>
  .cookies {
    position: fixed;
    left: 12px;
    right: 12px;
    bottom: calc(12px + env(safe-area-inset-bottom));
    z-index: 60;
    display: grid;
    gap: 12px;
    max-width: 560px;
    margin-inline: auto;
    padding: 18px;
    border-radius: var(--radio);
    background: var(--crema);
    box-shadow: 0 10px 30px rgb(59 46 40 / 0.25);
    font-size: 0.95rem;
  }

  .cookies[hidden] {
    display: none;
  }

  .botones {
    display: flex;
    gap: 10px;
    justify-content: flex-end;
    flex-wrap: wrap;
  }

  .botones .boton {
    min-height: 44px;
    padding: 8px 22px;
  }
</style>
