---
import { Picture } from 'astro:assets';
import { precio } from '../lib/enlaces';
import { altFoto, fotoDe, urlProducto, type Producto } from '../lib/catalogo';
import { anchos } from '../lib/imagenes';

interface Props {
  producto: Producto;
  nivel?: 'h2' | 'h3';
  prioridad?: boolean;
}
const { producto, nivel: Titulo = 'h3', prioridad = false } = Astro.props;
const { nombre, resumen, disponible } = producto.data;
const foto = fotoDe(producto, 0);
---

<a class="tarjeta" href={urlProducto(producto)}>
  <div class="foto">
    <Picture
      src={foto}
      alt={altFoto(producto, 0)}
      formats={['avif', 'webp']}
      widths={anchos(foto, [240, 360, 480, 640])}
      sizes="(min-width: 1800px) 16vw, (min-width: 1400px) 19vw, (min-width: 960px) 23vw, (min-width: 640px) 31vw, 46vw"
      loading={prioridad ? 'eager' : 'lazy'}
      fetchpriority={prioridad ? 'high' : undefined}
    />
    {!disponible && <span class="agotado">Agotado</span>}
  </div>
  <div class="cuerpo">
    <Titulo class="nombre">{nombre}</Titulo>
    {resumen && <p class="resumen">{resumen}</p>}
    <p class="precio precio-num">{precio(producto.data.precio)}</p>
    <span class="ver" aria-hidden="true">Ver más</span>
  </div>
</a>

<style>
  .tarjeta {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--tarjeta);
    border-radius: var(--radio);
    overflow: hidden;
    text-decoration: none;
    color: var(--texto);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .tarjeta:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 24px rgb(59 46 40 / 0.14);
  }

  .foto {
    position: relative;
    aspect-ratio: 1;
    background: var(--crema);
  }

  .foto :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .agotado {
    position: absolute;
    top: 10px;
    left: 10px;
    padding: 4px 12px;
    border-radius: 999px;
    background: var(--texto);
    color: var(--crema);
    font-weight: 700;
    font-size: 0.85rem;
  }

  .cuerpo {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 14px 14px 16px;
  }

  .nombre {
    font-size: 1.12rem;
    line-height: 1.2;
  }

  .resumen {
    margin-top: 4px;
    color: var(--texto-suave);
    font-size: 0.9rem;
    line-height: 1.35;
  }

  .precio {
    margin-top: auto;
    padding-top: 10px;
    font-size: 1.3rem;
    font-weight: 600;
  }

  .ver {
    margin-top: 10px;
    padding: 9px 12px;
    border-radius: 999px;
    background: var(--boton);
    color: var(--crema);
    text-align: center;
    font-weight: 700;
    font-size: 0.92rem;
  }

  .tarjeta:hover .ver {
    background: var(--boton-hover);
  }
</style>
