---
import { Picture } from 'astro:assets';
import { precio } from '../lib/enlaces';
import { urlProducto, type Producto } from '../lib/catalogo';

interface Props {
  producto: Producto;
  nivel?: 'h2' | 'h3';
  prioridad?: boolean;
}
const { producto, nivel: Titulo = 'h3', prioridad = false } = Astro.props;
const { nombre, resumen, fotos, disponible } = producto.data;
const foto = fotos[0];
// Tamaños a generar, sin pasar del tamaño de la foto original.
const anchos = [240, 360, 480, 640].filter((w) => w < foto.src.width).concat(Math.min(foto.src.width, 800));
---

<a class="tarjeta" href={urlProducto(producto)}>
  <div class="foto">
    <Picture
      src={foto.src}
      alt={foto.alt}
      formats={['avif', 'webp']}
      widths={anchos}
      sizes="(min-width: 1040px) 240px, (min-width: 960px) 23vw, (min-width: 640px) 31vw, 46vw"
      loading={prioridad ? 'eager' : 'lazy'}
      fetchpriority={prioridad ? 'high' : undefined}
    />
    {!disponible && <span class="agotado">Agotado</span>}
  </div>
  <div class="cuerpo">
    <Titulo class="nombre">{nombre}</Titulo>
    {resumen && <p class="resumen">{resumen}</p>}
    <p class="precio">{precio(producto.data.precio)}</p>
    <span class="ver" aria-hidden="true">Ver más</span>
  </div>
</a>

<style>
  .tarjeta {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--tarjeta);
    border-radius: var(--radio);
    overflow: hidden;
    text-decoration: none;
    color: var(--texto);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .tarjeta:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 24px rgb(59 46 40 / 0.14);
  }

  .foto {
    position: relative;
    aspect-ratio: 1;
    background: var(--crema);
  }

  .foto :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .agotado {
    position: absolute;
    top: 10px;
    left: 10px;
    padding: 4px 12px;
    border-radius: 999px;
    background: var(--texto);
    color: var(--crema);
    font-family: var(--f-titulos);
    font-size: 0.85rem;
  }

  .cuerpo {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 14px 14px 16px;
    font-family: var(--f-titulos);
  }

  .nombre {
    font-size: 1.15rem;
  }

  .resumen {
    margin-top: 4px;
    color: var(--texto-suave);
    font-size: 0.95rem;
    line-height: 1.35;
  }

  .precio {
    margin-top: auto;
    padding-top: 12px;
    font-size: 1.3rem;
  }

  .ver {
    margin-top: 10px;
    padding: 9px 12px;
    border-radius: 12px;
    background: var(--boton);
    color: var(--crema);
    text-align: center;
    font-size: 1rem;
  }

  .tarjeta:hover .ver {
    background: var(--boton-hover);
  }
</style>
