---
import Logo from './Logo.astro';
import Redes from './Redes.astro';
import { lugar, tienda } from '../data/tienda';
import { ruta } from '../lib/enlaces';
import { menu } from '../lib/navegacion';
---

<footer class="pie">
  <div class="contenedor">
    <a class="marca" href={ruta('/')}>
      <span class="ovalo"><Logo /></span>
      <span class="nombre">{tienda.nombre}</span>
    </a>
    <p class="lema">{tienda.lema}</p>
    {lugar && <p class="lema">Entregas en {lugar}</p>}
    <Redes class="redes-pie" />
    <nav aria-label="Pie de página">
      <ul>
        <li><a href={ruta('/')}>Inicio</a></li>
        {
          menu.map((m) => (
            <li>
              <a href={m.href}>{m.texto}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <p class="legal">
      © {new Date().getFullYear()} {tienda.nombre} · <a href={ruta('/privacidad/')}>Aviso de privacidad</a>
      {
        tienda.google.analytics && (
          <>
            {' · '}
            <button type="button" class="enlace-boton" data-preferencias-cookies>
              Preferencias de cookies
            </button>
          </>
        )
      }
    </p>
  </div>
</footer>

<style>
  .pie {
    margin-top: 64px;
    padding-block: 40px calc(32px + env(safe-area-inset-bottom));
    background: var(--crema);
    text-align: center;
  }

  .marca {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    text-decoration: none;
  }

  .ovalo {
    display: grid;
    place-items: center;
    width: 48px;
    height: 66px;
    border-radius: 999px;
    background: var(--fondo);
  }

  .ovalo :global(svg),
  .ovalo :global(img) {
    width: 28px;
    height: auto;
  }

  .nombre {
    font-family: var(--f-titulos);
    font-weight: 600;
    font-size: 1.6rem;
    line-height: 1;
  }

  .lema {
    margin-top: 6px;
    color: var(--texto-suave);
  }

  .pie :global(.redes-pie) {
    margin-top: 12px;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 20px;
    list-style: none;
    margin: 12px 0 0;
    padding: 0;
  }

  nav a {
    display: inline-block;
    padding-block: 10px;
    font-weight: 700;
    font-size: 0.95rem;
  }

  .legal {
    margin-top: 16px;
    font-size: 0.9rem;
    color: var(--texto-suave);
  }

  .legal a,
  .enlace-boton {
    color: inherit;
  }

  .enlace-boton {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    text-decoration: underline;
    cursor: pointer;
  }
</style>
