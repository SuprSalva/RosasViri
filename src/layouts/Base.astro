---
import '@fontsource/playfair-display/600.css';
import '@fontsource/playfair-display/600-italic.css';
import '@fontsource/lato/400.css';
import '@fontsource/lato/700.css';
import '../styles/global.css';
import AvisoCookies from '../components/AvisoCookies.astro';
import Encabezado from '../components/Encabezado.astro';
import Pie from '../components/Pie.astro';
import { tienda } from '../data/tienda';
import { ruta } from '../lib/enlaces';

interface Props {
  titulo?: string;
  descripcion?: string;
  /** Imagen para la vista previa al compartir (ruta ya con el base del sitio). */
  imagen?: string;
  /** Datos estructurados para Google (schema.org). */
  datos?: object;
  /** Página actual, para marcarla en el menú. */
  actual?: string;
  /** Pide a Google que no muestre esta página (404, administración). */
  noindex?: boolean;
}

const { titulo, descripcion = tienda.descripcion, imagen, datos, actual, noindex = false } = Astro.props;

const ciudad = tienda.zona.ciudad ? ` en ${tienda.zona.ciudad}` : '';
const tituloCompleto = titulo ? `${titulo} | ${tienda.nombre}` : `${tienda.nombre} · ${tienda.lema}${ciudad}`;
const canonica = new URL(Astro.url.pathname, Astro.site);
const vistaPrevia = new URL(imagen ?? ruta('/og-image.jpg'), Astro.site);
const ocultar = noindex || !tienda.google.indexar;
// Evita que un texto con "</script>" cierre la etiqueta antes de tiempo.
const jsonLd = datos && JSON.stringify(datos).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="es-MX">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonica} />
    {ocultar && <meta name="robots" content="noindex" />}
    {tienda.google.verificacion && <meta name="google-site-verification" content={tienda.google.verificacion} />}
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="theme-color" content="#f2e6d8" />
    <link rel="icon" href={ruta('/favicon.ico')} sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href={ruta('/favicon.svg')} />
    <link rel="apple-touch-icon" href={ruta('/apple-touch-icon.png')} />
    <link rel="manifest" href={ruta('/site.webmanifest')} />
    <link rel="sitemap" href={ruta('/sitemap-index.xml')} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:site_name" content={tienda.nombre} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={vistaPrevia} />
    <meta name="twitter:card" content="summary_large_image" />

    {jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>
    <Encabezado actual={actual} />
    <main id="contenido">
      <slot />
    </main>
    <Pie />
    {tienda.google.analytics && <AvisoCookies idAnalytics={tienda.google.analytics} />}
  </body>
</html>
